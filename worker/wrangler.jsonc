{
  "name": "perldoc-jp",
  "main": "src/index.js",
  "compatibility_date": "2026-07-25",

  // 公開入口は Custom Domain (perldoc.jp / staging.perldoc.jp) だけにする。
  // workers_dev は既定で true のため、放置すると本番 Worker がゾーンの
  // Cache / Redirect / Rate Limiting を通らない workers.dev 上の入口を持って
  // しまう (preview_urls の既定は workers_dev の値を継承)。env にも継承される
  "workers_dev": false,
  "preview_urls": false,

  // エラーの構造化ログを Workers Logs に残す。invocation_logs を切っているのは、
  // 正常なリクエストの 1 件ごとのログは保存件数を食うだけで、ここで見たいのは
  // proxy が失敗したときの console.error だけのため
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },

  // Workers Cache (Worker の手前のキャッシュ層。docs/cloud-run.md §10 の
  // エッジキャッシュ節)。HIT ではこの Worker 自体が起動しない。保持の可否と
  // TTL は src/index.js が全レスポンスへ明示する Cloudflare-CDN-Cache-Control
  // で制御する。ここを有効にしたままヘッダー側を消すと、RFC 9111 の
  // ヒューリスティック (404 も 180 秒保持など) で意図しない保持が始まる。
  // cross_version_cache は既定 (false) のまま = Worker のデプロイごとに空の
  // キャッシュから始まる。デプロイは稀で、コールドスタートは内側の fetch
  // キャッシュが吸収する。裏返しとして、壊れた新 version が有効化された
  // 場合に旧 version の保存済み応答へはフォールバックできない (新コードの
  // 即時反映を優先する意図的な選択)
  "cache": { "enabled": true },

  // ORIGIN (Cloud Run のサービス URL) は §7 の分類で機密 locator として扱う。
  // 平文の vars ではなく secret として scripts/deploy.sh が --secrets-file で
  // 毎デプロイ注入する。required 宣言により、secret の無い本番デプロイは
  // 失敗する (fail-closed。dry-run では検査されない)。
  // 手元で wrangler dev するときは worker/.dev.vars に ORIGIN=https://... を書く
  "secrets": { "required": ["ORIGIN"] },

  // 本番の Custom Domain (perldoc.jp) は routes に書かない。deploy が DNS の
  // 切り替えを伴うと事故になるため、cutover は Cloudflare 側の操作として分けている
  // (docs/cloud-run.md §10)。staging は壊れても影響がないので宣言的に作る
  "env": {
    "staging": {
      "name": "perldoc-jp-staging",
      "routes": [
        {
          "pattern": "staging.perldoc.jp",
          "custom_domain": true
        }
      ],
      // vars は環境間で継承されないので、staging でだけ効く。
      // 手順書のコマンドに --var を足す形だと付け忘れが無症状で通ってしまい、
      // staging が検索結果に出る
      "vars": {
        "NOINDEX": "1"
      },
      // secrets.required は継承に頼らず staging にも明示する
      "secrets": { "required": ["ORIGIN"] },
      // cache も同様に明示する。staging は cutover 前の検証環境 (§10 の
      // 動作確認) なので、本番と同じ二層キャッシュで動かす
      "cache": { "enabled": true }
    }
  }
}
